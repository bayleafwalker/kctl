{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bayleafwalker/kctl/schemas/knowledge-artifact-v1.schema.json",
  "title": "knowledge-artifact/v1",
  "description": "One published kctl knowledge entry, emitted as one line of a versioned NDJSON snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_id",
    "entry_id",
    "stream",
    "status",
    "title",
    "body",
    "content_digest",
    "category",
    "tags",
    "source",
    "published_at",
    "rendered_at",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-artifact/v1"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "entry_id": {
      "type": "integer",
      "minimum": 1
    },
    "stream": {
      "enum": ["durable", "coordination"]
    },
    "status": {
      "const": "published"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "category": {
      "enum": ["decision", "pattern", "lesson", "risk", "reference"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_ref",
        "sprint_id",
        "item_id",
        "track"
      ],
      "properties": {
        "event_id": {
          "type": "integer",
          "minimum": 1
        },
        "event_ref": {
          "type": "string",
          "pattern": "^sprintctl:event:[1-9][0-9]*$"
        },
        "sprint_id": {
          "type": "integer",
          "minimum": 1
        },
        "item_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "track": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "rendered_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "superseded_by": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
