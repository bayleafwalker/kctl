{
  "schema_version": "test-context/v1",
  "id": "kctl.knowledge.central-workflow",
  "owner_repo": "kctl",
  "subject": "central-knowledge-review-and-publication-reference",
  "contract_ref": {
    "doc_id": "kctl.central-knowledge-workflow",
    "revision": "sha256:8d6cdea6d01719b0f9c853ec6edb36ced34dc809358dc19fa1ae7a7bb5129429"
  },
  "source_of_truth": "postgresql-knowledge-workflow-plus-git-published-content",
  "depth": 2,
  "backends": ["sqlite-export", "json-transfer", "postgresql"],
  "actors": [
    "local-exporter",
    "deployment-migrator-a",
    "deployment-migrator-b",
    "runtime-importer",
    "runtime-reader",
    "vuoro-knowledge-adapter",
    "generic-vuoro-client"
  ],
  "initial_state": [
    "a local SQLite candidate and publication may exist",
    "the central schema may be absent or one migration behind",
    "Git contains the referenced published content"
  ],
  "operations": [
    {
      "name": "export-local",
      "actors": ["local-exporter"],
      "synchronization": "single-writer-atomic-replace"
    },
    {
      "name": "migrate",
      "actors": ["deployment-migrator-a", "deployment-migrator-b"],
      "synchronization": "per-schema-postgresql-advisory-transaction-lock"
    },
    {
      "name": "check-compatibility",
      "actors": ["runtime-reader"],
      "synchronization": "read-only-catalog-inspection"
    },
    {
      "name": "import-local",
      "actors": ["runtime-importer"],
      "synchronization": "per-schema-and-repository-postgresql-advisory-transaction-lock"
    },
    {
      "name": "intake-candidate",
      "actors": ["vuoro-knowledge-adapter"],
      "synchronization": "per-schema-and-repository-postgresql-advisory-transaction-lock"
    },
    {
      "name": "approve-or-reject",
      "actors": ["vuoro-knowledge-adapter"],
      "synchronization": "candidate-row-lock-plus-git-basis-check"
    },
    {
      "name": "record-publication-reference",
      "actors": ["vuoro-knowledge-adapter"],
      "synchronization": "candidate-row-lock-plus-repository-advisory-transaction-lock"
    },
    {
      "name": "supersede-publication",
      "actors": ["vuoro-knowledge-adapter"],
      "synchronization": "publication-row-lock-plus-cycle-check"
    },
    {
      "name": "bounded-read",
      "actors": ["runtime-reader", "generic-vuoro-client"],
      "synchronization": "read-only-limit-100"
    }
  ],
  "consistency": {
    "target": "application-invariant",
    "object": "central-knowledge-transfer-and-schema"
  },
  "assumptions": {
    "isolation": "postgresql-read-committed-plus-transaction-advisory-locks",
    "clock": "database-clock-plus-exporter-supplied-UTC-timestamp",
    "fairness": "a lock holder eventually commits or disconnects"
  },
  "bounds": {
    "candidates": 1000,
    "publications": 1000,
    "migration_jobs": 2,
    "operation_sequences": 100,
    "served_read_limit": 100,
    "service_restarts": 1
  },
